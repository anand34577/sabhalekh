{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sabhalekh",
  "version": "1.2.0",
  "identifier": "app.sabhalekh.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Sabhalekh",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "transparent": true,
        "decorations": true,
        "dragDropEnabled": true,
        "windowEffects": { "effects": ["mica"], "state": "followsWindowActiveState" },
        "additionalBrowserArgs": "--disable-features=msSmartScreenProtection,msEdgeTranslate,AutofillServerCommunication,OptimizationHints,MediaRouter --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --no-pings --disable-client-side-phishing-detection"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sabhalekh",
    "homepage": "https://github.com/anand34577/sabhalekh",
    "shortDescription": "Offline meeting transcription with speaker labels (English, Hindi, Hinglish)",
    "longDescription": "Record or import meetings and get speaker-labelled transcripts in English, Hindi and Hinglish. Everything runs on this PC; nothing is ever uploaded.",
    "copyright": "Copyright (c) 2026 Anand. MIT License.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../build/backend/": "backend/",
      "../../build/models/": "models/",
      "../../fonts/": "fonts/",
      "../../build/bin/": "bin/",
      "../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  },
  "plugins": {}
}
