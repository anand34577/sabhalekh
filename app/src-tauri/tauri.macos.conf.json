{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sabhalekh",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "decorations": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msSmartScreenProtection,msEdgeTranslate,AutofillServerCommunication,OptimizationHints,MediaRouter --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --no-pings --disable-client-side-phishing-detection",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
